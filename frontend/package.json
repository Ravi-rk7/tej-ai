{
  "name": "frontend",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": "22.x"
  },
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "lint": "eslint",
    "test": "node --test test/*.test.js",
    "test:e2e:staging": "playwright test",
    "test:e2e:staging:list": "playwright test --list",
    "test:e2e:compat": "playwright test --config=playwright.compat.config.js",
    "test:e2e:compat:list": "playwright test --config=playwright.compat.config.js --list"
  },
  "dependencies": {
    "@sentry/browser": "^10.72.0",
    "@supabase/supabase-js": "^2.105.1",
    "next": "16.3.1",
    "react": "19.2.4",
    "react-dom": "19.2.8"
  },
  "devDependencies": {
    "@playwright/test": "^1.62.1",
    "@tailwindcss/postcss": "^4",
    "eslint": "^9",
    "eslint-config-next": "16.3.1",
    "tailwindcss": "^4"
  }
}
