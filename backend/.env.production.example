# Production template only. Configure these as hosting secrets; do not create a
# committed production .env file. Replace every placeholder.
APP_ENV=production
NODE_ENV=production
PORT=3001
API_BASE_URL=https://api.example.com
FRONTEND_URL=https://example.com
LOG_LEVEL=info
RELEASE_SHA=<DEPLOYED_GIT_COMMIT_SHA>

SUPABASE_URL=https://production-project.supabase.co
SUPABASE_ANON_KEY=<PRODUCTION_SUPABASE_ANON_KEY>
SUPABASE_SERVICE_ROLE_KEY=<PRODUCTION_SUPABASE_SERVICE_ROLE_KEY>

AILABTOOLS_API_KEY=<PRODUCTION_AILABTOOLS_API_KEY>
AILAB_API_URL=https://www.ailabapi.com/api/portrait/analysis/skin-analysis-pro
OPENAI_API_KEY=<PRODUCTION_OPENAI_API_KEY>
AILAB_DAILY_CALL_LIMIT=<APPROVED_MAX_DAILY_PROVIDER_CALLS>
OPENAI_DAILY_CALL_LIMIT=<APPROVED_MAX_DAILY_OPENAI_CALLS>
PROVIDER_USAGE_RETENTION_DAYS=90

UPSTASH_REDIS_REST_URL=https://production-instance.upstash.io
UPSTASH_REDIS_REST_TOKEN=<PRODUCTION_UPSTASH_REDIS_REST_TOKEN>
# Generate independently from every other secret; minimum 32 characters.
SECURITY_HMAC_SECRET=<PRODUCTION_SECURITY_HMAC_SECRET_32_PLUS_CHARACTERS>

READINESS_TIMEOUT_MS=1000
READINESS_CACHE_MS=30000
SENTRY_DSN=<PRODUCTION_BACKEND_SENTRY_DSN_OPTIONAL>
OPS_ALERT_WEBHOOK_URL=<ACTIVELY_MONITORED_HTTPS_WEBHOOK>

DODO_ENVIRONMENT=live_mode
BILLING_CHECKOUT_ENABLED=false
DODO_API_KEY=<DODO_LIVE_API_KEY>
DODO_WEBHOOK_SECRET=<DODO_LIVE_WEBHOOK_SECRET>
DODO_BUSINESS_ID=<DODO_LIVE_BUSINESS_ID>
DODO_PRODUCT_ID_STARTER=<DODO_LIVE_STARTER_PRODUCT_ID>
DODO_PRODUCT_ID_GROWTH=<DODO_LIVE_GROWTH_PRODUCT_ID>
DODO_PRODUCT_ID_PRO=<DODO_LIVE_PRO_PRODUCT_ID>
DODO_API_BASE_URL=https://live.dodopayments.com
BILLING_WEBHOOK_ENABLED=false
BILLING_PORTAL_ENABLED=false
DODO_CHECKOUT_RETURN_URL=https://api.example.com/api/billing/return
DODO_CHECKOUT_CANCEL_URL=https://api.example.com/api/billing/cancel

PRIVACY_NOTICE_VERSION=face-scan-2026-01
PRIVACY_CONSENT_ENFORCEMENT=true
PRIVACY_AUDIT_RETENTION_DAYS=365
DELETION_AUDIT_HMAC_SECRET=<PRODUCTION_DELETION_AUDIT_HMAC_SECRET_32_PLUS_CHARACTERS>
