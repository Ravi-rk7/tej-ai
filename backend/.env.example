# Copy this file to .env. Use staging/test credentials locally.

# Application
APP_ENV=development
NODE_ENV=development
PORT=3001
API_BASE_URL=http://localhost:3001
FRONTEND_URL=http://localhost:3000
LOG_LEVEL=info

# Supabase (service role is server-only)
SUPABASE_URL=
SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=

# AILabTools Skin Analyze Pro
AILABTOOLS_API_KEY=
AILAB_API_URL=https://www.ailabapi.com/api/portrait/analysis/skin-analysis-pro

# OpenAI (derived metrics only; never send face images or identity data)
OPENAI_API_KEY=

# Provider spending circuit breakers. Zero disables the database guard only in
# local development; staging and production require positive limits.
AILAB_DAILY_CALL_LIMIT=0
OPENAI_DAILY_CALL_LIMIT=0
PROVIDER_USAGE_RETENTION_DAYS=90

# Upstash Redis
UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=
# Dedicated HMAC key for pseudonymous abuse-control identifiers (32+ characters).
SECURITY_HMAC_SECRET=

# Readiness and optional error monitoring. Sentry receives sanitized errors only.
READINESS_TIMEOUT_MS=1000
READINESS_CACHE_MS=30000
SENTRY_DSN=
OPS_ALERT_WEBHOOK_URL=

# Dodo Payments test mode
DODO_ENVIRONMENT=test_mode
BILLING_CHECKOUT_ENABLED=false
DODO_API_KEY=
DODO_WEBHOOK_SECRET=
DODO_BUSINESS_ID=
DODO_PRODUCT_ID_STARTER=
DODO_PRODUCT_ID_GROWTH=
DODO_PRODUCT_ID_PRO=
DODO_API_BASE_URL=https://test.dodopayments.com
BILLING_WEBHOOK_ENABLED=false
BILLING_PORTAL_ENABLED=false
DODO_CHECKOUT_RETURN_URL=http://localhost:3001/api/billing/return
DODO_CHECKOUT_CANCEL_URL=http://localhost:3001/api/billing/cancel

# Privacy and irreversible deletion
PRIVACY_NOTICE_VERSION=face-scan-2026-01
PRIVACY_CONSENT_ENFORCEMENT=true
PRIVACY_AUDIT_RETENTION_DAYS=365
# Generate a dedicated random secret of at least 32 characters. Never expose it to the browser.
DELETION_AUDIT_HMAC_SECRET=
