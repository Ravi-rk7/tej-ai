# --- Supabase ------------------------------------------------
# Project URL and keys from supabase.com -> Project Settings -> API
SUPABASE_URL=
SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=

# --- Cloudinary ----------------------------------------------
# From cloudinary.com -> Dashboard -> API Keys
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=

# --- AILabTools ----------------------------------------------
# From ailabapi.com -> Console -> API Keys
AILABTOOLS_API_KEY=

# --- OpenAI ---------------------------------------------------
# From platform.openai.com -> API Keys
OPENAI_API_KEY=

# --- Upstash Redis -------------------------------------------
# From console.upstash.com -> Your Redis DB -> REST API
UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=

# --- Dodo Payments -------------------------------------------
# From dodopayments.com -> Developers -> API Keys
# Webhook secret from dodopayments.com -> Developers -> Webhooks
# Product IDs from dodopayments.com -> Products (one per plan)
DODO_API_KEY=
DODO_WEBHOOK_SECRET=
DODO_PRODUCT_ID_STARTER=
DODO_PRODUCT_ID_GROWTH=
DODO_PRODUCT_ID_PRO=

# --- App ------------------------------------------------------
PORT=4000
FRONTEND_URL=http://localhost:3000
NODE_ENV=development
