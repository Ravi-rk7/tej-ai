# Copy this file to .env. Use staging/test credentials locally.

# Application
NODE_ENV=development
PORT=3001
API_BASE_URL=http://localhost:3001
FRONTEND_URL=http://localhost:3000
LOG_LEVEL=info

# Supabase (service role is server-only)
SUPABASE_URL=
SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=

# AILabTools Skin Analyze Pro
AILABTOOLS_API_KEY=
AILAB_API_URL=https://www.ailabapi.com/api/portrait/analysis/skin-analysis-pro

# OpenAI (derived metrics only; never send face images or identity data)
OPENAI_API_KEY=

# Upstash Redis
UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=

# Dodo Payments test mode
DODO_API_KEY=
DODO_WEBHOOK_SECRET=
DODO_PRODUCT_ID_STARTER=
DODO_PRODUCT_ID_GROWTH=
DODO_PRODUCT_ID_PRO=
DODO_API_BASE_URL=https://test.dodopayments.com

# Legacy only. The production MVP will process images transiently and remove
# Cloudinary from the scan path on Day 3.
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=
