# Copy this file to .env. Use staging/test credentials locally.

# Application
APP_ENV=development
NODE_ENV=development
PORT=3001
API_BASE_URL=http://localhost:3001
FRONTEND_URL=http://localhost:3000
LOG_LEVEL=info

# Supabase (service role is server-only)
SUPABASE_URL=
SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=

# AILabTools Skin Analyze Pro
AILABTOOLS_API_KEY=
AILAB_API_URL=https://www.ailabapi.com/api/portrait/analysis/skin-analysis-pro

# OpenAI (derived metrics only; never send face images or identity data)
OPENAI_API_KEY=

# Upstash Redis
UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=

# Dodo Payments test mode
DODO_ENVIRONMENT=test_mode
BILLING_CHECKOUT_ENABLED=false
DODO_API_KEY=
DODO_WEBHOOK_SECRET=
DODO_PRODUCT_ID_STARTER=
DODO_PRODUCT_ID_GROWTH=
DODO_PRODUCT_ID_PRO=
DODO_API_BASE_URL=https://test.dodopayments.com
DODO_CHECKOUT_RETURN_URL=http://localhost:3001/api/billing/return
DODO_CHECKOUT_CANCEL_URL=http://localhost:3001/api/billing/cancel
