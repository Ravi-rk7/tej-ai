# See README.md for setup. Never commit real credentials.
APP_ENV=development
NODE_ENV=development
PORT=3001
API_BASE_URL=http://localhost:3001
FRONTEND_URL=http://localhost:3000
# Portfolio runtime: no payment, AILabTools or LLM credentials are needed.
SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=
UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=
SECURITY_HMAC_SECRET=
DELETION_AUDIT_HMAC_SECRET=
LIVE_SCAN_ENABLED=false
SKIN_ANALYSIS_PROVIDER=facepp
FACEPP_API_KEY=
FACEPP_API_SECRET=
FACEPP_WINDOW_CALL_LIMIT=80
FACEPP_DAILY_CALL_LIMIT=5
ROUTINE_MODE=rules
PRIVACY_CONSENT_ENFORCEMENT=true
PRIVACY_NOTICE_VERSION=facepp-portfolio-2026-09
PRIVACY_AUDIT_RETENTION_DAYS=365
READINESS_TIMEOUT_MS=1000
READINESS_CACHE_MS=30000
RELEASE_SHA=
SENTRY_DSN=
LOG_LEVEL=info
