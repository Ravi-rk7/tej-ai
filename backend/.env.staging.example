# Copy to .env for a local staging run. Replace every placeholder.
NODE_ENV=staging
PORT=3001
API_BASE_URL=https://api-staging.example.com
FRONTEND_URL=https://staging.example.com
LOG_LEVEL=info

SUPABASE_URL=https://staging-project.supabase.co
SUPABASE_ANON_KEY=<STAGING_SUPABASE_ANON_KEY>
SUPABASE_SERVICE_ROLE_KEY=<STAGING_SUPABASE_SERVICE_ROLE_KEY>

AILABTOOLS_API_KEY=<STAGING_AILABTOOLS_API_KEY>
AILAB_API_URL=https://www.ailabapi.com/api/portrait/analysis/skin-analysis-pro
OPENAI_API_KEY=<STAGING_OPENAI_API_KEY>

UPSTASH_REDIS_REST_URL=https://staging-instance.upstash.io
UPSTASH_REDIS_REST_TOKEN=<STAGING_UPSTASH_REDIS_REST_TOKEN>

DODO_API_KEY=<DODO_TEST_API_KEY>
DODO_WEBHOOK_SECRET=<DODO_TEST_WEBHOOK_SECRET>
DODO_PRODUCT_ID_STARTER=<DODO_TEST_STARTER_PRODUCT_ID>
DODO_PRODUCT_ID_GROWTH=<DODO_TEST_GROWTH_PRODUCT_ID>
DODO_PRODUCT_ID_PRO=<DODO_TEST_PRO_PRODUCT_ID>
DODO_API_BASE_URL=https://test.dodopayments.com

# Optional legacy integration. Cloudinary is not part of the production image path.
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=
